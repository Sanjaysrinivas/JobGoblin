# Copy to .env and fill in. NEVER commit .env (it is gitignored).

APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string

# Database (matches docker-compose default)
DATABASE_URL=postgresql+psycopg://jobgoblin:jobgoblin@db:5432/jobgoblin

# AI provider — Ollama (local, GPU-accelerated)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_FAST_MODEL=llama3.2:3b

# Uploads
FILE_STORAGE_PATH=/data/uploads
MAX_UPLOAD_MB=10

# Seed admin (created on first boot; bootstraps invite-only registration)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Dev only — production is same-origin behind Caddy
FRONTEND_ORIGIN=http://localhost:3000

# Google OAuth (login/signup). Leave empty to disable Google sign-in; the app
# boots fine without it and the /auth/google/* endpoints return 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL the Google callback is reachable at (used to build redirect_uri).
# Must match an Authorized redirect URI in the Google Cloud console:
#   <OAUTH_REDIRECT_BASE_URL>/api/auth/google/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# Email allowlist (private tool). Comma-separated; only these emails may sign in
# with Google. Empty = nobody is admitted via Google (fail-closed).
ALLOWED_EMAILS=

# TOTP MFA (authenticator app)
TOTP_ISSUER=JobGoblin
